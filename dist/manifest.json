{
  "manifest_version": 3,
  "name": "UnoSender — WhatsApp Bulk Sender",
  "version": "1.0.0",
  "description": "Send personalized bulk WhatsApp messages directly from WhatsApp Web. No subscription, no external API.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "scripting",
    "alarms",
    "notifications",
    "downloads"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "UnoSender"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["vendors/wa.js", "content/wa-bridge.js"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
