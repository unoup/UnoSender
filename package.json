{
  "name": "unosender",
  "version": "1.0.0",
  "description": "Bulk WhatsApp messaging Chrome extension — no subscription, no external API",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "zip": "cd dist && zip -r ../unosender.zip . && echo 'unosender.zip created'",
    "test": "jest"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.10.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mini-css-extract-plugin": "^2.8.1",
    "path": "^0.12.7",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "libphonenumber-js": "^1.12.33",
    "papaparse": "^5.4.1",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "jest": {
